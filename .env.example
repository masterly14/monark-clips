# Copia este archivo como `.env` (en la raíz del proyecto) y pon tu propia key.
# `.env` está en .gitignore: nunca lo subas al repositorio ni pegues la key en un mensaje.

# ElevenLabs, para generar SFX nuevos con `node scripts/sfx-gen.mjs`.
# Solo hace falta si vas a crear sonidos; para editar y renderizar no se usa.
ELEVENLABS_API_KEY=
